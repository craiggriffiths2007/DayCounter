<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="DayCounter.ThemeSelectionPopup"
               x:TypeArguments="system:String">
    <VerticalStackLayout WidthRequest="300" Padding="24" Spacing="14"
                         BackgroundColor="#F4F7F3">
        <Label Text="Choose a theme" FontSize="23" FontAttributes="Bold"
               TextColor="#183B36" HorizontalTextAlignment="Center" />
        <Button x:Name="WeatherButton" Text="Storm to Sunshine"
                Clicked="OnWeatherClicked" CornerRadius="12"
                BackgroundColor="#E0E8E3" TextColor="#183B36" />
        <Button x:Name="ClassicButton" Text="Classic Green"
                Clicked="OnClassicClicked" CornerRadius="12"
                BackgroundColor="#E0E8E3" TextColor="#183B36" />
        <Button Text="Cancel" Clicked="OnCancelClicked"
                BackgroundColor="Transparent" TextColor="#536B65" />
    </VerticalStackLayout>
</toolkit:Popup>
